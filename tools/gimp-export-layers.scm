(define (safe-char ch)
  (if (or (char-alphabetic? ch)
          (char-numeric? ch)
          (char=? ch #\_)
          (char=? ch #\-))
      ch
      #\_))

(define (sanitize-name name)
  (list->string (map safe-char (string->list name))))

(define (string-prefix? prefix text)
  (let ((prefix-len (string-length prefix))
        (text-len (string-length text)))
    (and (<= prefix-len text-len)
         (string=? prefix (substring text 0 prefix-len)))))

(define (hide-all-top-layers image)
  (let* ((layers-info (gimp-image-get-layers image))
         (layer-count (car layers-info))
         (layer-array (cadr layers-info)))
    (let loop ((i 0))
      (if (< i layer-count)
          (begin
            (gimp-item-set-visible (aref layer-array i) FALSE)
            (loop (+ i 1)))))))

(define (export-layer-copy src-image index output-dir)
  (let* ((dup-image (car (gimp-image-duplicate src-image)))
         (layers-info (gimp-image-get-layers dup-image))
         (layer-array (cadr layers-info))
         (layer (aref layer-array index))
         (layer-name (car (gimp-item-get-name layer)))
         (safe-name (sanitize-name layer-name))
         (outfile (string-append output-dir "/" (number->string (+ index 1)) "__" safe-name ".png")))
    (hide-all-top-layers dup-image)
    (gimp-item-set-visible layer TRUE)
    (let* ((merged (car (gimp-image-merge-visible-layers dup-image CLIP-TO-IMAGE))))
      (file-png-save RUN-NONINTERACTIVE dup-image merged outfile outfile 0 9 0 0 0 0 0)
      (gimp-image-delete dup-image))))

(define (script-fu-export-top-layers input-path output-dir skip-prefix)
  (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE input-path input-path)))
         (layers-info (gimp-image-get-layers image))
         (layer-count (car layers-info))
         (layer-array (cadr layers-info)))
    (let loop ((i 0))
      (if (< i layer-count)
          (begin
            (let* ((layer (aref layer-array i))
                   (layer-name (car (gimp-item-get-name layer))))
              (if (not (string-prefix? skip-prefix layer-name))
                  (export-layer-copy image i output-dir)))
            (loop (+ i 1)))))
    (gimp-image-delete image)))
